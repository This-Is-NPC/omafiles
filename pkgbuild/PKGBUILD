# omafiles, packaged for pacman from the committed tree of this repository.
#
# The local twin of the recipe in omarchy-pkgs, which builds the same files
# from the tarball of a tag: same build, same file list, same `.install`. This
# one takes the tree with `git archive HEAD`, so a build is of a commit, never
# of uncommitted changes. scripts/package builds it (`mise run package`), and
# the release workflow runs that script on the tagged checkout and attaches
# the package to the GitHub release that install.sh downloads.
pkgname=omafiles
# Moved by release-please, and by nothing else: between two releases every
# build of the tree has the same version, so install one by path with
# `pacman -U`, never by name.
pkgver=0.2.0 # x-release-please-version
pkgrel=1
pkgdesc='Tag files and browse them, from a command line and a Qt Quick file manager'
arch=('x86_64')
url='https://github.com/This-Is-NPC/omafiles'
license=('MIT')
install='omafiles.install'
options=('!debug')
depends=(
  'glibc'
  'libgcc'
  'libstdc++'
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-multimedia'      # quick preview plays audio and video
  'qt6-webengine'       # QtPdf: quick preview renders PDF pages
  'libarchive'          # the archive helper compresses and extracts
  'glib2'               # the device helper's volume monitor; `gio trash`
  'kwindowsystem'       # parents the portal file chooser to the asking window
  'xdg-desktop-portal'  # the file chooser is a portal backend
  'xdg-utils'           # xdg-mime makes omafiles the default file manager
)
optdepends=(
  'gvfs: removable drives and the Trash on other filesystems'
  'gvfs-mtp: Android phones'
  'gvfs-afc: iPhones'
  'gvfs-gphoto2: cameras'
  'udisks2: mount, unmount and eject drives'
)
makedepends=('gcc' 'git' 'make' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-webengine'
             'libarchive' 'glib2' 'kwindowsystem')

_tree="${OMAFILES_TREE:-$startdir/..}"

prepare() {
  rm -rf "$srcdir/$pkgname-$pkgver"
  mkdir "$srcdir/$pkgname-$pkgver"
  git -C "$_tree" archive HEAD | tar -x -C "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  mkdir -p build
  cd build
  qmake6 ../omafiles.pro
  make -j"$(nproc)"
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  # The binaries need each Qt module at the minor release they were built
  # against or a newer one (Qt versions its symbols): pacman then brings that
  # module along, or refuses, instead of installing a program that cannot
  # start. Each module is pinned to its own version, because they do not move
  # together: qt6-webengine can trail qt6-base by a release.
  local dep minor pinned=()
  for dep in "${depends[@]}"; do
    case "$dep" in
      qt6-*)
        minor="$(pacman -Q "$dep" | awk '{ split($2, v, "."); print v[1] "." v[2] }')"
        pinned+=("$dep>=$minor") ;;
      *) pinned+=("$dep") ;;
    esac
  done
  depends=("${pinned[@]}")

  local program
  for program in omafiles omafiles-studio omafiles-preview omafiles-archive omafiles-devices; do
    install -Dm755 "build/bin/$program" "$pkgdir/usr/bin/$program"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 pkgbuild/omafiles.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omafiles.svg"
  install -Dm644 pkgbuild/omafiles.desktop "$pkgdir/usr/share/applications/omafiles.desktop"
  install -Dm644 pkgbuild/omafiles.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/omafiles.portal"
  install -Dm644 pkgbuild/org.freedesktop.impl.portal.desktop.omafiles.service \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.omafiles.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/cli.md "$pkgdir/usr/share/doc/$pkgname/cli.md"
}
